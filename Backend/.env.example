DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=
GEMINI_API_KEY=
# Optional. Comma-separated, tried in order when one is busy or out of quota.
GEMINI_EXTRACT_MODELS=
# The deployed frontend's address, comma-separated if more than one. Not needed locally.
CORS_ALLOWED_ORIGINS=http://localhost:5180
# HubSpot service key (or a legacy private app token). Used when N8N_WEBHOOK_URL is empty.
HUBSPOT_TOKEN=
# Optional. Your HubSpot account ID, so the app can link to the records it creates.
HUBSPOT_PORTAL_ID=
HUBSPOT_DEAL_STAGE=closedwon
# Optional. When set, records go through the n8n workflow instead of straight to HubSpot.
N8N_WEBHOOK_URL=
# Shared with n8n to sign both directions. Use a long random string.
N8N_SHARED_SECRET=
# The address n8n can reach this API at, for its callback.
PUBLIC_API_URL=http://localhost:8020
UPLOADS_PER_USER_DAY=10
UPLOADS_PER_DAY=100
# Optional. Password reset by email. Without SMTP_USER and SMTP_PASSWORD it stays hidden.
# For Gmail, use an app password. Links point at the first CORS_ALLOWED_ORIGINS address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
